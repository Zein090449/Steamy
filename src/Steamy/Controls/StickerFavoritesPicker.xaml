<UserControl x:Class="Steamy.Controls.StickerFavoritesPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Steamy.Controls" FontFamily="{DynamicResource SteamyFontFamily}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Steamy;component/Resources/SocialStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Width="414" MaxHeight="520" Padding="18" Background="{DynamicResource SocialNotificationBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" CornerRadius="18">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Stickers" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBlock Text="Save the stickers you use most, then pick one to paste it into your message." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
   </StackPanel>
   <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:TextBox x:Name="LinkBox" Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Paste a Discord sticker link" Style="{StaticResource SocialField}" AutomationProperties.Name="Sticker link" KeyDown="Link_KeyDown" />
    <ui:Button Grid.Column="1" Content="Save" Command="{Binding AddCommand}" Style="{StaticResource SocialQuietButton}" Margin="6,0,0,0" ToolTip="Save this sticker" AutomationProperties.Name="Save sticker" />
   </Grid>
   <Grid Grid.Row="2" MinHeight="110" MaxHeight="300" Margin="0,12,0,4">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageScrollHostStyle}">
     <ItemsControl ItemsSource="{Binding Favorites}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Width="104" Margin="0,0,6,8">
       <Grid>
        <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Name}" Padding="0" BorderThickness="0" Background="{DynamicResource SocialFieldBrush}" AutomationProperties.Name="{Binding Name}">
         <controls:ChatImagePreview Url="{Binding Url}" Width="104" Height="104" MinWidth="0" MaxWidth="104" Margin="0" IsHitTestVisible="False" />
        </Button>
        <ui:Button Content="✕" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SocialQuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,1" MinHeight="20" Margin="0,2,2,0" Background="{DynamicResource SocialNotificationBrush}" ToolTip="Remove favorite" AutomationProperties.Name="Remove favorite sticker" />
       </Grid>
       <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,4,2,0" />
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock Text="No favorite stickers yet. Paste a link above to save the first one." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="270" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Favorites.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Grid.Row="4" Text="Tip: right-click a sticker in Discord, copy its image address, and paste it here." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
  </Grid>
 </Border>
</UserControl>
