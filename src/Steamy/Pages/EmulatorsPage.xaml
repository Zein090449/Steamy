<Page x:Class="Steamy.Pages.EmulatorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource PageBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="28,24,28,40" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">

      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Emulators" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock Text="Play your own PlayStation 5, PlayStation 4, Nintendo Switch, and Switch 2 games with open-source emulators."
                     Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>
        <ui:Button Grid.Column="1" Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}"
                   Command="{Binding CheckAllCommand}" Appearance="Secondary" VerticalAlignment="Center"/>
      </Grid>

      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Bring your own games" Style="{StaticResource CardTitleStyle}" FontSize="13"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Steamy installs only the emulator programs. Game dumps, firmware, BIOS files, and keys are not included — use copies you own and are allowed to run. Emulators are independent open-source projects, so compatibility and system requirements vary by game."/>
          <TextBlock Style="{StaticResource TertiaryTextStyle}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{Binding RootPath, StringFormat=Emulators are installed in {0}}"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
            <ui:SymbolIcon Symbol="XboxController24" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="Download, install, and launch each emulator from its card below."
                       Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Emulators}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,12,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                  <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                  <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="6,2"
                             Command="{Binding OpenProjectCommand}" ToolTip="Open the project page"
                             AutomationProperties.Name="{Binding OpenProjectActionName}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="ArrowRight24" FontSize="12" Margin="0,0,5,0"/>
                      <TextBlock Text="Project page" FontSize="11"/>
                    </StackPanel>
                  </ui:Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}"
                          CornerRadius="10" Padding="8,2" Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="UPDATE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                           FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"/>

                <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Requirements}" Style="{StaticResource TertiaryTextStyle}"
                               FontSize="10.5" TextWrapping="Wrap"/>
                  </Grid>
                </Border><Border Grid.Row="5" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" Visibility="{Binding SupportsGameLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding GamesHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Add file" Click="AddGameFile_Click" Tag="{Binding}" Appearance="Secondary" FontSize="10.5" Padding="8,2" Margin="0,0,6,0" AutomationProperties.Name="{Binding AddGameActionName}"/>
                        <ui:Button Content="Add folder" Click="AddGameFolder_Click" Tag="{Binding}" Appearance="Secondary" FontSize="10.5" Padding="8,2" ToolTip="Add a game folder (shadPS4 and Kyty dumps)"/>
                        <ui:Button Content="Download" Click="DownloadGameFile_Click" Tag="{Binding}" Appearance="Secondary" FontSize="10.5" Padding="8,2" ToolTip="Download from dlps_downloader" AutomationProperties.Name="{Binding DownloadGameActionName}"/>
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,6,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayCommand}" Appearance="Secondary" FontSize="10.5" Padding="8,2" AutomationProperties.Name="{Binding PlayActionName}"/>
                              <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" Appearance="Transparent" Padding="6,2" Margin="4,0,0,0" ToolTip="Remove from Steamy" AutomationProperties.Name="{Binding RemoveActionName}"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No games added yet — add a dump you own." Style="{StaticResource TertiaryTextStyle}" FontSize="10.5" Margin="0,6,0,0" Visibility="{Binding HasNoGames, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Row="6" Margin="0,12,0,0">
                  <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                  <ProgressBar Height="3" Margin="0,8,0,0" Maximum="100"
                               Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <Grid Grid.Row="7" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ui:Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Appearance="Primary"
                             MinWidth="92" AutomationProperties.Name="{Binding InstallActionName}"/>
                  <ui:Button Grid.Column="1" Content="Launch" Icon="{ui:SymbolIcon Play24}" Command="{Binding LaunchCommand}"
                             Appearance="Secondary" HorizontalAlignment="Left" Margin="8,0,0,0"
                             AutomationProperties.Name="{Binding LaunchActionName}"/>
                  <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Folder24}" Command="{Binding OpenFolderCommand}"
                             Appearance="Secondary" ToolTip="Open the install folder"
                             AutomationProperties.Name="{Binding OpenFolderActionName}"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</Page>
