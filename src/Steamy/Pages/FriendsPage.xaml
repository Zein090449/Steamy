<Page x:Class="Steamy.Pages.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Steamy.Pages"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False" Background="Transparent" FontFamily="{DynamicResource SteamyFontFamily}" UseLayoutRounding="True">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Steamy;component/Resources/SocialStyles.xaml" /></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" /><system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="SocialMessageMaxWidth">480</system:Double>
      <local:SocialFilterConverter x:Key="FilterEquals" />
      <local:SocialDayConverter x:Key="SocialDay" />
      <local:SocialUnreadConverter x:Key="SocialUnread" />
      <local:SocialFilterCountConverter x:Key="FilterCount" />
      <local:SocialConversationPreviewConverter x:Key="ConversationPreview" />
      <local:SocialConversationTimeConverter x:Key="ConversationTime" />
      <local:SocialUnreadWeightConverter x:Key="ConversationUnreadWeight" />
      <local:SocialEqualToVisibilityConverter x:Key="EqualToVis" />
      <local:SocialMemberSinceConverter x:Key="MemberSince" />
      <local:SocialPresenceColorConverter x:Key="PresenceColor" />
      <local:SocialInverseBoolConverter x:Key="InverseBoolToVis" />
      <CollectionViewSource x:Key="Timeline" Source="{Binding Messages}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="DayKey" /></CollectionViewSource.GroupDescriptions></CollectionViewSource>
      <Style x:Key="FriendRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" CornerRadius="10" Background="Transparent" Padding="10,8" Margin="0,1" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SocialAccentSoftBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <DataTemplate x:Key="ProfileCard">
        <Border CornerRadius="16" Background="{DynamicResource SocialSolidCardBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" Width="300" ClipToBounds="True">
          <StackPanel>
            <Border Height="76" Background="{DynamicResource SocialSolidBannerBrush}" />
            <Border HorizontalAlignment="Left" Margin="16,-42,0,0" Width="84" Height="84" CornerRadius="42" Background="{DynamicResource SocialSolidCardBrush}">
              <controls:SocialAvatar Diameter="84" Url="{Binding AvatarUrl}" Initial="{Binding Initial}" Presence="{Binding Presence}" ShowPresence="True" BadgeSurface="{DynamicResource SocialSolidCardBrush}" />
            </Border>
            <StackPanel Margin="16,8,16,14">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <Border CornerRadius="7" Background="#593695" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center" Visibility="{Binding DataContext.SecretBadgeVisibility, Source={x:Reference SocialRoot}}"><TextBlock Text="Secret" FontSize="9.5" FontWeight="SemiBold" Foreground="White" /></Border>
              </StackPanel>
              <TextBlock Text="{Binding Username, StringFormat=@{0}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Presence, Converter={StaticResource PresenceColor}}" Margin="0,6,0,0" />
              <TextBlock Text="{Binding Id, Converter={StaticResource MemberSince}}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
              <WrapPanel Margin="0,12,0,0">                <ui:Button Content="Message" Click="ProfileMessage_Click" Style="{StaticResource SocialPrimaryButton}" Padding="12,7" MinHeight="34" Margin="0,0,8,6" AutomationProperties.Name="Open message composer" />
                <ui:Button Content="Play together" Command="{Binding DataContext.PlayWithFriendCommand, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource SocialQuietButton}" Padding="11,6" MinHeight="34" Margin="0,0,8,6" Background="{DynamicResource SurfaceSubtleBrush}" />
                <ui:Button Content="Invite" Command="{Binding DataContext.InvitePersonCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource SocialQuietButton}" Padding="11,6" MinHeight="34" Margin="0,0,0,6" Background="{DynamicResource SurfaceSubtleBrush}" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>
  <Grid x:Name="SocialRoot" Margin="24,18,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="DockHeader" Visibility="Collapsed" Margin="14,4,10,0">
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <Border Background="Transparent" Padding="0" Margin="0,4,8,4"><UniformGrid Columns="2">
          <Button x:Name="DockFriendsTab" Click="DockFriends_Click" Style="{StaticResource SocialDockTab}" Tag="True"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="People24" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="Friends"/></StackPanel></Button>
          <Button x:Name="DockChatsTab" Click="DockChats_Click" Style="{StaticResource SocialDockTab}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Chat24" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="Chats"/></StackPanel></Button>
        </UniformGrid></Border>
        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss20}" Style="{StaticResource SocialQuietButton}" Width="30" Height="30" MinHeight="30" Padding="5" VerticalAlignment="Center" Click="DockClose_Click" AutomationProperties.Name="Close friends panel" ToolTip="Close · Esc"/>
      </Grid>
      <Grid x:Name="DockAccount" Grid.Row="1" Margin="2,8,0,10" Visibility="{Binding ConnectedVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:SocialAvatar Diameter="30" Margin="0,0,10,0" Url="{Binding AvatarUrl}" Initial="S" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding AccountLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="Discord connected" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel></Grid>
        <ui:Button x:Name="DockPartyButton" Grid.Column="1" Icon="{ui:SymbolIcon People24}" Style="{StaticResource SocialQuietButton}" Width="32" Height="32" MinHeight="32" Padding="7" Click="CompactParty_Click" AutomationProperties.Name="Party and invitations" ToolTip="Party and invitations" />
        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon MoreHorizontal24}" Style="{StaticResource SocialQuietButton}" Width="32" Height="32" MinHeight="32" Padding="7" Click="AccountMenu_Click" AutomationProperties.Name="Discord account options" />
      </Grid>
    </Grid>
    <Grid x:Name="SocialHeader" Margin="4,0,4,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Friends" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{Binding FriendSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ConnectedVisibility}">
        <controls:SocialStatusBadge Diameter="9" Presence="Online" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{Binding AccountLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ui:Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource SocialQuietButton}" Visibility="{Binding ConnectionActionVisibility}" />
        <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SocialQuietButton}" Visibility="{Binding BusyVisibility}" />
        <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" Style="{StaticResource SocialQuietButton}" Click="AccountMenu_Click" ToolTip="Discord account" AutomationProperties.Name="Discord account options" />
      </StackPanel>
    </Grid>

    <Border x:Name="ConnectSurface" Grid.Row="1" Visibility="{Binding DisconnectedVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="940" Background="{DynamicResource SocialBackdropBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="36,32" controls:RoundedClip.Radius="16"><Grid x:Name="ConnectLayout">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel x:Name="ConnectIntroduction" VerticalAlignment="Center" MaxWidth="420" Margin="0,0,40,0">
        <Border HorizontalAlignment="Left" CornerRadius="16" Background="{DynamicResource SocialActionBrush}" Padding="14" Margin="0,0,0,20">
          <ui:SymbolIcon Symbol="People24" FontSize="26" Foreground="White" />
        </Border>
        <TextBlock Text="Good games. Better company." FontSize="34" LineHeight="41" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="Your Discord friends, a shared chat and one place to plan your next game." FontSize="15" LineHeight="24" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,24" />
        <StackPanel>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SocialAccentSoftBrush}" Margin="0,0,12,0"><ui:SymbolIcon Symbol="People24" FontSize="19" Foreground="{DynamicResource SocialAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Your friends, live" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Requests, presence and avatars synced straight from Discord." FontSize="12" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SocialAccentSoftBrush}" Margin="0,0,12,0"><ui:SymbolIcon Symbol="Chat24" FontSize="19" Foreground="{DynamicResource SocialAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Chat that keeps up" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Messages, GIFs, images and delivery retry without leaving Steamy." FontSize="12" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SocialAccentSoftBrush}" Margin="0,0,12,0"><ui:SymbolIcon Symbol="Games24" FontSize="19" Foreground="{DynamicResource SocialAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Party up in one tap" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Group chat, private voice calls and play-together invites." FontSize="12" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
          </Grid>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource SocialEdgeBrush}" Margin="0,4" />
      <controls:DiscordConnectionCard Grid.Column="2" Model="{Binding}" MinWidth="360" MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="40,0,0,0" />
    </Grid></Border>

    <Border x:Name="SocialWorkspaceSurface" Grid.Row="1" Visibility="{Binding ConnectedVisibility}" CornerRadius="20" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" controls:RoundedClip.Radius="20">
      <Grid>
       <controls:ShellBackdropView IsPageBackdrop="True" BaseBrush="{DynamicResource WorkspaceBackgroundBrush}" />
       <Grid x:Name="SocialWorkspace" Background="{DynamicResource SocialBackdropBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="PartyGap" Width="1" /><ColumnDefinition x:Name="PartyColumn" Width="280" /></Grid.ColumnDefinitions>

        <Border x:Name="ContactListSurface" Background="{DynamicResource SocialSidebarBrush}"><Grid Margin="12,18,12,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="8,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="RosterTitle" Text="Messages" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon PersonAdd24}" Command="{Binding ToggleAddFriendCommand}" Style="{StaticResource SocialQuietButton}" ToolTip="Add a friend" AutomationProperties.Name="Add a friend" />
          </Grid>
          <ui:TextBox Grid.Row="1" Style="{StaticResource SocialField}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search your friends" AutomationProperties.Name="Search Discord friends" />
          <ui:Button x:Name="PartyChatShortcut" Grid.Row="2" Command="{Binding OpenPartyChatCommand}" Visibility="{Binding PartyVisibility}" Background="{DynamicResource SocialAccentSoftBrush}" BorderThickness="0" Padding="12" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="People24" Foreground="{DynamicResource SocialAccentBrush}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="Party chat" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{Binding PartyTitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></Grid>
          </ui:Button>
          <WrapPanel Grid.Row="3" Margin="0,10,0,10" HorizontalAlignment="Center">
            <RadioButton Tag="All" GroupName="SocialFilter" Style="{StaticResource SocialTab}" IsChecked="{Binding SelectedFilter, Converter={StaticResource FilterEquals}, ConverterParameter=All}" Margin="0,0,2,2">
              <RadioButton.Content><MultiBinding Converter="{StaticResource FilterCount}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></RadioButton.Content>
            </RadioButton>
            <RadioButton Tag="DMs" GroupName="SocialFilter" Style="{StaticResource SocialTab}" IsChecked="{Binding SelectedFilter, Converter={StaticResource FilterEquals}, ConverterParameter=DMs}" Margin="0,0,2,2">
              <RadioButton.Content><MultiBinding Converter="{StaticResource FilterCount}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></RadioButton.Content>
            </RadioButton>
            <RadioButton Tag="Groups" GroupName="SocialFilter" Style="{StaticResource SocialTab}" IsChecked="{Binding SelectedFilter, Converter={StaticResource FilterEquals}, ConverterParameter=Groups}" Margin="0,0,2,2">
              <RadioButton.Content><MultiBinding Converter="{StaticResource FilterCount}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></RadioButton.Content>
            </RadioButton>
            <RadioButton Tag="Unread" GroupName="SocialFilter" Style="{StaticResource SocialTab}" IsChecked="{Binding SelectedFilter, Converter={StaticResource FilterEquals}, ConverterParameter=Unread}" Margin="0,0,2,2">
              <RadioButton.Content><MultiBinding Converter="{StaticResource FilterCount}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></RadioButton.Content>
            </RadioButton>
          </WrapPanel>
          <StackPanel Grid.Row="4" Visibility="{Binding AddFriendVisibility}" Margin="0,0,0,12">
            <ui:TextBox x:Name="FriendUsernameBox" Style="{StaticResource SocialField}" Text="{Binding NewFriend, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Discord username or ID" AutomationProperties.Name="Discord username or user ID"><ui:TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendRequestCommand}" /></ui:TextBox.InputBindings></ui:TextBox>
            <ui:Button x:Name="SendFriendRequestButton" Content="Send request" Command="{Binding SendRequestCommand}" Style="{StaticResource SocialPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
          </StackPanel>
          <ListBox x:Name="DiscordFriendsList" Grid.Row="5" ItemsSource="{Binding Friends}" SelectedItem="{Binding SelectedFriend}" ItemContainerStyle="{StaticResource FriendRow}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel><Grid>
                <Grid.ContextMenu><ContextMenu>
                  <MenuItem Header="Mark as read" Command="{Binding DataContext.MarkFriendReadCommand, Source={x:Reference SocialRoot}}" CommandParameter="{Binding}" />
                  <MenuItem Header="Copy user ID" Command="{Binding DataContext.CopyUserIdCommand, Source={x:Reference SocialRoot}}" CommandParameter="{Binding}" />
                  <MenuItem Header="Block on Discord" Command="{Binding DataContext.BlockCommand, Source={x:Reference SocialRoot}}" CommandParameter="{Binding}" Visibility="{Binding IsBlocked, Converter={StaticResource InverseBoolToVis}}" />
                  <MenuItem Header="Unblock" Command="{Binding DataContext.UnblockCommand, Source={x:Reference SocialRoot}}" CommandParameter="{Binding}" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}" />
                  <MenuItem Header="Remove friend" Command="{Binding DataContext.RemoveCommand, Source={x:Reference SocialRoot}}" CommandParameter="{Binding}" Visibility="{Binding IsFriend, Converter={StaticResource BoolToVis}}" />
                </ContextMenu></Grid.ContextMenu>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <controls:SocialAvatar Diameter="40" Margin="0,0,10,0" VerticalAlignment="Center" Url="{Binding AvatarUrl}" Initial="{Binding Initial}" Presence="{Binding Presence}" ShowPresence="True" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <controls:HighlightTextBlock SourceText="{Binding DisplayName}" Term="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Page}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                      <controls:HighlightTextBlock.FontWeight><MultiBinding Converter="{StaticResource ConversationUnreadWeight}"><Binding Path="Id" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></controls:HighlightTextBlock.FontWeight>
                    </controls:HighlightTextBlock>
                    <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,1,0,0" VerticalAlignment="Center"><TextBlock.Text><MultiBinding Converter="{StaticResource ConversationTime}"><Binding Path="Id" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></TextBlock.Text></TextBlock>
                  </Grid>
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource ConversationPreview}"><Binding Path="Id" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.ConversationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="Detail" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8.5" Background="#f23f43" Height="17" MinWidth="17" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ContactUnread}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="ContactUnread" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"><TextBlock.Text><MultiBinding Converter="{StaticResource SocialUnread}"><Binding Path="Id" /><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" /><Binding Path="DataContext.NotificationEpoch" RelativeSource="{RelativeSource AncestorType=Page}" /></MultiBinding></TextBlock.Text></TextBlock></Border>
              </Grid>
              <WrapPanel Margin="0,8,0,0"><WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsFriend}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <ui:Button Content="Accept" Style="{StaticResource SocialQuietButton}" Padding="7,4" Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Content="Decline" Style="{StaticResource SocialQuietButton}" Padding="7,4" Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Content="Cancel" Style="{StaticResource SocialQuietButton}" Padding="7,4" Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.CancelRequestCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Content="Unblock" Style="{StaticResource SocialQuietButton}" Padding="7,4" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
              </WrapPanel></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="5" Visibility="{Binding EmptyVisibility}" Margin="12,24,12,0"><TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding EmptyDescription}" FontSize="11" LineHeight="18" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
        </Grid></Border>
        <Border Grid.Column="1" Background="{DynamicResource SocialBorderBrush}" />

        <Border x:Name="ChatSurface" Grid.Column="2" Background="{DynamicResource SocialCanvasBrush}"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border x:Name="ConversationHeader" BorderBrush="{DynamicResource SocialBorderBrush}" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ui:Button x:Name="DockChatBackButton" Visibility="Collapsed" Icon="{ui:SymbolIcon ChevronLeft24}" Style="{StaticResource SocialQuietButton}" Width="30" MinHeight="30" Padding="5" Click="DockFriends_Click" AutomationProperties.Name="Back to friends" />
              <controls:SocialAvatar Grid.Column="1" Diameter="38" Margin="0,0,12,0" Url="{Binding ChatAvatarUrl}" Initial="{Binding ChatInitial}" Presence="{Binding SelectedFriend.Presence}"><controls:SocialAvatar.Style><Style TargetType="controls:SocialAvatar"><Setter Property="ShowPresence" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding ChatAvatarUrl}" Value="{x:Null}"><Setter Property="ShowPresence" Value="False" /></DataTrigger></Style.Triggers></Style></controls:SocialAvatar.Style></controls:SocialAvatar>
              <StackPanel x:Name="ConversationIdentity" Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding ChatTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ChatSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="StartVoiceCallButton" Icon="{ui:SymbolIcon Call24}" Content="Call" Command="{Binding Voice.StartCallCommand}" CommandParameter="{Binding SelectedFriend}" Style="{StaticResource SocialQuietButton}" Visibility="{Binding FriendMenuVisibility}" ToolTip="{Binding Voice.StartCallLabel}" AutomationProperties.Name="{Binding Voice.StartCallLabel}" />
                <ui:Button x:Name="PlayWithFriendButton" Icon="{ui:SymbolIcon Games24}" Content="{Binding PlayWithFriendLabel}" Command="{Binding PlayWithFriendCommand}" Style="{StaticResource SocialQuietButton}" Background="{DynamicResource SocialAccentSoftBrush}" Foreground="{DynamicResource SocialAccentBrush}" CornerRadius="18" Visibility="{Binding FriendMenuVisibility}" ToolTip="{Binding PartyTitle}" />
                <ui:Button x:Name="ProfilePanelButton" Icon="{ui:SymbolIcon Person24}" Content="Profile" Style="{StaticResource SocialQuietButton}" Click="ProfilePanel_Click" Visibility="{Binding FriendMenuVisibility}" ToolTip="View profile" AutomationProperties.Name="View profile" />
                <ui:Button x:Name="CompactPartyButton" Icon="{ui:SymbolIcon People24}" Content="{Binding CompactPartyLabel}" Style="{StaticResource SocialQuietButton}" Click="CompactParty_Click" Visibility="{Binding ConversationVisibility}" />
                <ui:Button x:Name="ReloadChatButton" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ReloadChatCommand}" Style="{StaticResource SocialQuietButton}" ToolTip="Reload this conversation from Discord" AutomationProperties.Name="Reload conversation from Discord" Visibility="{Binding ConversationVisibility}" />
                <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" Style="{StaticResource SocialQuietButton}" Click="ConversationMenu_Click" ToolTip="Conversation options" AutomationProperties.Name="Conversation options" Visibility="{Binding ConversationVisibility}" />
              </StackPanel>
            </Grid>
          </Border>
