      <ui:TextBox x:Name="QuickSwitcherBox" Style="{StaticResource SocialField}" PlaceholderText="Jump to a friend…" AutomationProperties.Name="Quick switcher search" />
      <ListBox x:Name="QuickSwitcherList" Height="280" Margin="0,8,0,0" ItemContainerStyle="{StaticResource FriendRow}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="QuickSwitcherList_KeyDown" MouseDoubleClick="QuickSwitcherList_DoubleClick">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:SocialAvatar Diameter="28" Margin="0,0,9,0" Url="{Binding AvatarUrl}" Initial="{Binding Initial}" Presence="{Binding Presence}" ShowPresence="True" /><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" /></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Enter opens · Esc closes" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,6,0,2" />
    </StackPanel></Border></Popup>
  </Grid>
</Page>
